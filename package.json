{
  "name": "pg-south-weather",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run validate:sites && vite",
    "build": "npm run validate:sites && tsc -b && vite build",
    "preview": "vite preview",
